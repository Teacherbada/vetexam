{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VetExam 精選解析批次匯入",
  "description": "最多 50 筆、UTF-8 JSON 最多 2 MiB。ID 必須來自題目維護中心，不能使用題號。僅新增公開國考題目解析草稿，不覆蓋任何既有解析。",
  "type": "object",
  "additionalProperties": false,
  "required": ["explanations"],
  "properties": {
    "explanations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "expectedAnswer", "explanation"],
        "properties": {
          "questionId": { "type": "integer", "minimum": 1, "maximum": 2147483647, "description": "現有公開國考題目的唯一 ID，同批不得重複" },
          "expectedAnswer": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 20000, "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$", "description": "完整 Markdown。含追加的來源網址，總計最多 20000 個 UTF-16 字元；不得僅空白或含 NUL。" },
          "questionFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "選填。使用預覽回傳的精確題目 SHA-256；不可自行猜測。" },
          "sourceReferences": {
            "type": "array", "maxItems": 10,
            "description": "只保存使用者提供的網址，不發送請求或自行查證。自動附加至 Markdown 末尾。",
            "items": { "type": "string", "maxLength": 2048, "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s<>\\\\\\u0000-\\u001f\\u007f]+$" }
          }
        }
      }
    }
  }
}
